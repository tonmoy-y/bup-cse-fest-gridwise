# Provider priority order (sequential failover, left to right). Only
# providers with at least one configured key are actually attempted.
LLM_PROVIDER_ORDER=gemini,grok

# Gemini: set GEMINI_API_KEY for a single key, or GEMINI_API_KEYS as a
# comma-separated list for key rotation on auth failure. Both are merged.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Grok (xAI): optional secondary provider, used only if Gemini is
# unconfigured or every Gemini candidate fails for this request.
GROK_API_KEY=
GROK_API_KEYS=
GROK_MODEL=grok-4-fast-non-reasoning
GROK_FALLBACK_MODEL=grok-3-mini

# Timeout per LLM HTTP call, and the hard cap on total LLM attempts (across
# all providers/keys) for a single /optimize-energy request.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=4
